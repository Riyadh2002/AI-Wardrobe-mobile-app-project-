# ==============================================================================
# AIWardrobe Backend Configuration
# ==============================================================================

# --- Google Gemini AI API Key ---
# Get your FREE API key here: https://aistudio.google.com/
# Gemini 2.5 Flash / 1.5 Flash provides multimodal vision & outfit synthesis.
# If left empty, the backend runs in Intelligent Fallback Mode.
GEMINI_API_KEY=

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# --- Supabase Database & Storage (Optional for persistent user data) ---
# Create a free project at https://supabase.com/
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenWeatherMap API Key (Optional for real-time weather) ---
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
